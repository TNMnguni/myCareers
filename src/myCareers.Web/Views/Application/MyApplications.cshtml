@model List<myCareers.Application.DTOs.JobApplication.JobApplicationDto>
@{
    ViewData["Title"] = "My Applications";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-file-alt me-2"></i>My Applications</h2>
                <a asp-controller="Jobs" asp-action="Browse" class="btn btn-primary">
                    <i class="fas fa-search me-2"></i>Browse Jobs
                </a>
            </div>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row">
            @foreach (var app in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">@app.JobTitle</h5>
                            <p class="text-muted mb-2">
                                <i class="fas fa-building me-1"></i>@app.Department
                            </p>
                            <p class="text-muted mb-3">
                                <small>Reference: @app.ReferenceNumber</small>
                            </p>

                            <div class="mb-3">
                                @if (app.Status == myCareers.Core.Enums.ApplicationStatus.Draft)
                                {
                                    <span class="badge bg-secondary">Draft</span>
                                }
                                else if (app.Status == myCareers.Core.Enums.ApplicationStatus.Submitted)
                                {
                                    <span class="badge bg-primary">Submitted</span>
                                }
                                else if (app.Status == myCareers.Core.Enums.ApplicationStatus.UnderReview)
                                {
                                    <span class="badge bg-warning">Under Review</span>
                                }
                                else if (app.Status == myCareers.Core.Enums.ApplicationStatus.Shortlisted)
                                {
                                    <span class="badge bg-info">Shortlisted</span>
                                }
                                else if (app.Status == myCareers.Core.Enums.ApplicationStatus.InterviewScheduled)
                                {
                                    <span class="badge bg-success">Interview Scheduled</span>
                                }
                                else if (app.Status == myCareers.Core.Enums.ApplicationStatus.Accepted)
                                {
                                    <span class="badge bg-success">Accepted</span>
                                }
                                else if (app.Status == myCareers.Core.Enums.ApplicationStatus.Rejected)
                                {
                                    <span class="badge bg-danger">Rejected</span>
                                }
                                else if (app.Status == myCareers.Core.Enums.ApplicationStatus.Withdrawn)
                                {
                                    <span class="badge bg-dark">Withdrawn</span>
                                }
                            </div>

                            <p class="card-text">
                                <small class="text-muted">
                                    <i class="fas fa-calendar me-1"></i>Applied: @app.AppliedDate.ToString("dd MMM yyyy")
                                </small><br />
                                <small class="text-muted">
                                    <i class="fas fa-clock me-1"></i>@app.DaysSinceApplied days ago
                                </small>
                            </p>
                        </div>
                        <div class="card-footer bg-light">
                            <div class="d-flex justify-content-between">
                                <a asp-action="Details" asp-route-id="@app.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-eye me-1"></i>View
                                </a>
                                @if (app.CanWithdraw)
                                {
                                    <form asp-action="Withdraw" asp-route-id="@app.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to withdraw this application?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-times me-1"></i>Withdraw
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-file-alt fa-4x text-muted mb-3"></i>
                        <h4>No Applications Yet</h4>
                        <p class="text-muted mb-4">You haven't submitted any applications. Start by browsing available positions.</p>
                        <a asp-controller="Jobs" asp-action="Browse" class="btn btn-primary btn-lg">
                            <i class="fas fa-search me-2"></i>Browse Available Jobs
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>