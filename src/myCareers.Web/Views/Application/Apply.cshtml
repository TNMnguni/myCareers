                            <tr><td class="text-muted">Email:</td><td>${$('[name="ContactDetails.Email"]').val()}</td></tr>
                            <tr><td class="text-muted">Phone:</td><td>${$('[name="ContactDetails.PhoneNumber"]').val()}</td></tr>
                        </table>
                    </div>
