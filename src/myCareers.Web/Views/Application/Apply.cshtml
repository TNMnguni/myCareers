                        <!-- Section 8: Documents -->
                        <div class="form-section" id="section-8">
                            <h4 class="border-bottom pb-2 mb-4">Section 8: Supporting Documents</h4>

                            <div class="alert alert-info mb-4">
                                <i class="fas fa-info-circle me-2"></i>
                                <strong>Required Documents:</strong>
                                <ul class="mb-0 mt-2">
                                    <li>Curriculum Vitae (CV/Resume)</li>
                                    <li>ID Document or Passport</li>
                                    <li>Qualification Certificates</li>
