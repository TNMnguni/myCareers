                            <tr><td class="text-muted">Job Title:</td><td><strong>${$('[name="PositionInfo.JobTitle"]').val()}</strong></td></tr>
                            <tr><td class="text-muted">Department:</td><td>${$('[name="PositionInfo.Department"]').val()}</td></tr>
                        </table>
                    </div>
                    <div class="col-md-6">
