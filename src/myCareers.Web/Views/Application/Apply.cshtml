</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        // ==================== GLOBAL VARIABLES ====================
        let currentStep = 1;
        const totalSteps = 9;
        let uploadedDocuments = [];
        let currentApplicationId = null;

        // ==================== INITIALIZATION ====================
        $(document).ready(function() {
            // Disable jQuery unobtrusive validation for this form to avoid conflicts
            $('#applicationForm').removeData('validator');
            $('#applicationForm').removeData('unobtrusiveValidation');

            updateStepIndicator();
            setupConditionalFields();
            setupDynamicFields();
            setupDocumentUpload();
        });

        // ==================== STEP NAVIGATION ====================
        $('#nextBtn').click(function() {
            if (validateCurrentStep()) {
                if (currentStep < totalSteps) {
                    currentStep++;
                    showStep(currentStep);
                }
            }
        });

        $('#prevBtn').click(function() {
            if (currentStep > 1) {
                currentStep--;
                showStep(currentStep);
            }
        });

        function showStep(step) {
            $('.form-section').removeClass('active');
            $(`#section-${step}`).addClass('active');

            $('#prevBtn').toggle(step > 1);
            $('#nextBtn').toggle(step < totalSteps);
            $('#submitBtn').toggle(step === totalSteps);

            if (step === totalSteps) {
                populateReviewSummary();
            }

            updateStepIndicator();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function updateStepIndicator() {
            $('.step').each(function() {
                const stepNum = parseInt($(this).data('step'));
                $(this).removeClass('active completed');

                if (stepNum === currentStep) {
                    $(this).addClass('active');
                } else if (stepNum < currentStep) {
                    $(this).addClass('completed');
                }
            });
        }

        function validateCurrentStep() {
            const currentSection = $(`#section-${currentStep}`);
            let isValid = true;
            let errors = [];

            // Validate required fields
            currentSection.find('input[required], select[required], textarea[required]').each(function() {
                if (!this.checkValidity() || $(this).val() === '') {
                    isValid = false;
                    $(this).addClass('is-invalid');
                    const label = $(this).closest('.mb-3').find('label').first().text().replace('*', '').trim();
                    if (label && !errors.includes(label)) {
                        errors.push(label);
                    }
                } else {
                    $(this).removeClass('is-invalid');
                }
            });

            // Section-specific validations
            if (currentStep === 4) { // Languages
                const hasLanguage = $('.language-item').first().find('.language-select').val();
                if (!hasLanguage) {
                    isValid = false;
                    errors.push('At least one language proficiency');
                }
            }

            if (currentStep === 5) { // Qualifications
                const hasQualification = $('.qualification-item').first().find('[name$=".InstitutionName"]').val();
                if (!hasQualification) {
                    isValid = false;
                    errors.push('At least one qualification');
                }
            }

            if (currentStep === 7) { // References
                let validReferences = 0;
                $('.reference-item').each(function() {
                    const name = $(this).find('[name$=".Name"]').val();
                    const phone = $(this).find('[name$=".PhoneNumber"]').val();
                    if (name && phone) validReferences++;
                });
                if (validReferences < 1) {
                    isValid = false;
                    errors.push('At least one complete reference');
                }
            }

            if (currentStep === 8) { // Documents
                const requiredDocs = [
                    { type: 'Resume', label: 'Resume/CV' },
                    { type: 'ID', label: 'ID/Passport document' },
                    { type: 'Qualification', label: 'Qualification certificate' },
                    { type: 'Z83', label: 'Signed Z83 form' }
                ];

                requiredDocs.forEach(doc => {
                    if (!uploadedDocuments.some(d => d.documentType === doc.type)) {
                        isValid = false;
                        errors.push(doc.label);
                    }
                });
            }

            if (!isValid && errors.length > 0) {
                let errorMsg = 'Please complete the following:\n\n';
                errors.forEach(err => errorMsg += '• ' + err + '\n');
                alert(errorMsg);
            }

            return isValid;
        }

        // ==================== DOCUMENT UPLOAD ====================
        function setupDocumentUpload() {
            $(document).on('change', '.doc-upload', function() {
                const files = this.files;
                const documentType = $(this).data('doc-type');
                const container = $(this).closest('.mb-4');

                if (files.length > 0) {
                    Array.from(files).forEach(file => {
                        uploadDocument(file, documentType, container);
                    });
                }
            });

            $(document).on('click', '.remove-file', function() {
                const fileId = $(this).data('file-id');
                const fileItem = $(this).closest('.uploaded-file-item');

                if (confirm('Are you sure you want to remove this file?')) {
                    removeDocument(fileId, fileItem);
                }
            });
        }

        function uploadDocument(file, documentType, container) {
            // Validate file size
            if (file.size > 5 * 1024 * 1024) {
                alert('File size must not exceed 5MB');
                return;
            }

            // Validate file type
            const allowedExtensions = ['.pdf', '.jpg', '.jpeg', '.png'];
            const fileName = file.name.toLowerCase();
            const isValidType = allowedExtensions.some(ext => fileName.endsWith(ext));
            if (!isValidType) {
                alert('Invalid file type. Please upload PDF, JPG, or PNG files only.');
                return;
            }

            const formData = new FormData();
            formData.append('file', file);
            formData.append('documentType', documentType);

            if (currentApplicationId) {
                formData.append('applicationId', currentApplicationId);
            }

            const progressBar = container.find('.progress');
            const progressBarInner = container.find('.progress-bar');
            const statusDiv = container.find('.upload-status');
            const fileInput = container.find('.doc-upload');

            progressBar.show();
            fileInput.prop('disabled', true);
            progressBarInner.css('width', '0%').removeClass('bg-success bg-danger');
            statusDiv.html('<i class="fas fa-spinner fa-spin me-2"></i>Uploading...')
                .removeClass('text-success text-danger').addClass('text-primary');

            $.ajax({
                url: '/Application/UploadFile',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                xhr: function() {
                    const xhr = new window.XMLHttpRequest();
                    xhr.upload.addEventListener('progress', function(e) {
                        if (e.lengthComputable) {
                            const percentComplete = (e.loaded / e.total) * 100;
                            progressBarInner.css('width', percentComplete + '%');
                        }
                    }, false);
                    return xhr;
                },
                success: function(response) {
                    if (response.success) {
                        uploadedDocuments.push({
                            fileId: response.fileId,
                            fileName: response.fileName,
                            fileUrl: response.fileUrl,
                            documentType: documentType,
                            fileSize: response.fileSize || 0
                        });

                        statusDiv.html('<i class="fas fa-check-circle me-2"></i>Uploaded successfully')
                            .removeClass('text-primary text-danger').addClass('text-success');
                        progressBarInner.addClass('bg-success').css('width', '100%');

                        addUploadedFileToList(response, container, documentType);
                        fileInput.val('');
                    } else {
                        const errorMsg = response.errors ? response.errors.join(', ') : response.message;
                        statusDiv.html('<i class="fas fa-exclamation-circle me-2"></i>Error: ' + errorMsg)
                            .removeClass('text-primary text-success').addClass('text-danger');
                        progressBarInner.addClass('bg-danger').css('width', '100%');
                    }
                },
                error: function(xhr) {
                    console.error('Upload error:', xhr.responseText);
                    statusDiv.html('<i class="fas fa-exclamation-circle me-2"></i>Upload failed. Please try again.')
                        .removeClass('text-primary text-success').addClass('text-danger');
                    progressBarInner.addClass('bg-danger').css('width', '100%');
                },
                complete: function() {
                    setTimeout(() => {
                        progressBar.fadeOut();
                        statusDiv.fadeOut();
                    }, 3000);
                    fileInput.prop('disabled', false);
                }
            });
        }

        function addUploadedFileToList(response, container, documentType) {
            const uploadedFilesDiv = container.find('.uploaded-files');

            const fileItem = `
                <div class="uploaded-file-item d-flex align-items-center justify-content-between p-2 mb-2 border rounded bg-light" data-file-id="${response.fileId}">
                    <div class="file-info d-flex align-items-center">
                        <i class="fas fa-file-${getFileIcon(response.fileName)} me-2 text-primary"></i>
                        <div>
                            <span class="file-name d-block">${response.fileName}</span>
                            <small class="text-muted">${formatFileSize(response.fileSize || 0)}</small>
                        </div>
                    </div>
                    <div class="file-actions">
                        <a href="${response.fileUrl}" target="_blank" class="btn btn-sm btn-outline-primary me-1" title="View">
                            <i class="fas fa-eye"></i>
                        </a>
                        <button type="button" class="btn btn-sm btn-outline-danger remove-file" data-file-id="${response.fileId}" title="Remove">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            `;

            uploadedFilesDiv.append(fileItem);
        }

        function removeDocument(fileId, fileItem) {
            const formData = new FormData();
            formData.append('fileId', fileId);

            $.ajax({
                url: '/Application/DeleteDocument',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    if (response.success) {
                        uploadedDocuments = uploadedDocuments.filter(doc => doc.fileId !== fileId);
                        fileItem.fadeOut(300, function() {
                            $(this).remove();
                        });
                    } else {
                        alert('Failed to delete file: ' + response.message);
                    }
                },
                error: function(xhr) {
                    console.error('Delete error:', xhr.responseText);
                    alert('An error occurred while deleting the file');
                }
            });
        }

        function getFileIcon(fileName) {
            const ext = fileName.split('.').pop().toLowerCase();
            switch(ext) {
                case 'pdf': return 'pdf';
                case 'doc':
                case 'docx': return 'word';
                case 'jpg':
                case 'jpeg':
                case 'png': return 'image';
                default: return 'alt';
            }
        }

        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
        }

        // ==================== CONDITIONAL FIELDS ====================
        function setupConditionalFields() {
            $('input[name="PersonalInfo.HasDisability"]').change(function() {
                $('#disabilityDetailsDiv').toggle($(this).val() === 'true');
            });

            $('input[name="PersonalInfo.IsSouthAfricanCitizen"]').change(function() {
                $('#nonCitizenDiv').toggle($(this).val() === 'false');
            });

            $('input[name="PersonalInfo.HasCriminalRecord"]').change(function() {
                $('#criminalDetailsDiv').toggle($(this).val() === 'true');
            });

            $('input[name="PersonalInfo.HasPendingCriminalCase"]').change(function() {
                $('#pendingCriminalDetailsDiv').toggle($(this).val() === 'true');
            });

            $('input[name="PersonalInfo.HasBeenDismissed"]').change(function() {
                $('#dismissalDetailsDiv').toggle($(this).val() === 'true');
            });

            $('input[name="PersonalInfo.HasPendingDisciplinary"]').change(function() {
                $('#pendingDisciplinaryDetailsDiv').toggle($(this).val() === 'true');
            });

            $('input[name="PersonalInfo.RequiresOfficialRegistration"]').change(function() {
                $('#registrationDetailsDiv').toggle($(this).val() === 'true');
            });

            $(document).on('change', '.is-current-position', function() {
                const endDateInput = $(this).closest('.experience-item').find('.experience-end-date');
                if ($(this).is(':checked')) {
                    endDateInput.val('').prop('disabled', true);
                } else {
                    endDateInput.prop('disabled', false);
                }
            });
        }

        // ==================== DYNAMIC FIELDS ====================
        function setupDynamicFields() {
            let languageIndex = 1;
            let qualificationIndex = 1;
            let experienceIndex = 1;
            let referenceIndex = 1;

            $('#addLanguage').click(function() {
                const newLanguage = $('.language-item:first').clone();
                newLanguage.find('select, input').each(function() {
                    const name = $(this).attr('name');
                    if (name) {
                        $(this).attr('name', name.replace('[0]', `[${languageIndex}]`));
                    }
                    $(this).val('');
                });
                newLanguage.find('.remove-language').show();
                $('#languagesContainer').append(newLanguage);
                languageIndex++;
            });

            $('#addQualification').click(function() {
                const newQual = $('.qualification-item:first').clone();
                newQual.find('input').each(function() {
                    const name = $(this).attr('name');
                    if (name) {
                        $(this).attr('name', name.replace('[0]', `[${qualificationIndex}]`));
                    }
                    $(this).val('');
                });
                newQual.find('.remove-qualification').show();
                $('#qualificationsContainer').append(newQual);
                qualificationIndex++;
            });

            $('#addExperience').click(function() {
                const newExp = $('.experience-item:first').clone();
                newExp.find('input, textarea').each(function() {
                    const name = $(this).attr('name');
                    if (name) {
                        $(this).attr('name', name.replace('[0]', `[${experienceIndex}]`));
                    }
                    $(this).val('');
                    if ($(this).attr('type') === 'checkbox') {
                        $(this).prop('checked', false);
                    }
                });
                newExp.find('.remove-experience').show();
                $('#experienceContainer').append(newExp);
                experienceIndex++;
            });

            $('#addReference').click(function() {
                const newRef = $('.reference-item:first').clone();
                newRef.find('input').each(function() {
                    const name = $(this).attr('name');
                    if (name) {
                        $(this).attr('name', name.replace('[0]', `[${referenceIndex}]`));
                    }
                    $(this).val('');
                });
                newRef.find('.remove-reference').show();
                $('#referencesContainer').append(newRef);
                referenceIndex++;
            });

            $(document).on('click', '.remove-language', function() {
                if ($('.language-item').length > 1) {
                    $(this).closest('.language-item').remove();
                }
            });

            $(document).on('click', '.remove-qualification', function() {
                if ($('.qualification-item').length > 1) {
                    $(this).closest('.qualification-item').remove();
                }
            });

            $(document).on('click', '.remove-experience', function() {
                if ($('.experience-item').length > 1) {
                    $(this).closest('.experience-item').remove();
                }
            });

            $(document).on('click', '.remove-reference', function() {
                if ($('.reference-item').length > 1) {
                    $(this).closest('.reference-item').remove();
                }
            });
        }

        // ==================== SAVE DRAFT ====================
        $('#saveDraftBtn').click(function() {
            const btn = $(this);
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Saving...');

            const formData = gatherFormData();
            const request = {
                applicationId: currentApplicationId,
                application: formData
            };

            $.ajax({
                url: '/Application/SaveDraft',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(request),
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        currentApplicationId = response.applicationId;
                        alert('✓ Draft saved successfully!\n\nApplication ID: ' + response.applicationId);
                    } else {
                        const errorMsg = response.errors ? response.errors.join('\n') : response.message;
                        alert('Error saving draft:\n\n' + errorMsg);
                    }
                },
                error: function(xhr) {
                    console.error('Save draft error:', xhr.responseText);
                    if (xhr.status === 401) {
                        alert('Your session has expired. Please log in again.');
                        window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                    } else {
                        alert('An error occurred while saving your draft.\n\nPlease try again.');
                    }
                },
                complete: function() {
                    btn.prop('disabled', false).html('<i class="fas fa-save me-2"></i>Save as Draft');
                }
            });
        });

        // ==================== FORM SUBMISSION ====================
        $('#applicationForm').submit(function(e) {
            e.preventDefault();

            // Disable jQuery validation to avoid conflicts
            $(this).validate().cancelSubmit = true;

            if (!$('#declaration').is(':checked')) {
                alert('Please accept the declaration before submitting.');
                return false;
            }

            // Validate required documents
            const hasResume = uploadedDocuments.some(d => d.documentType === 'Resume');
            const hasID = uploadedDocuments.some(d => d.documentType === 'ID');
            const hasQual = uploadedDocuments.some(d => d.documentType === 'Qualification');
            const hasZ83 = uploadedDocuments.some(d => d.documentType === 'Z83');

            if (!hasResume || !hasID || !hasQual || !hasZ83) {
                alert('Please upload all required documents:\n\n' +
                      '• Resume/CV: ' + (hasResume ? '✓' : '✗') + '\n' +
                      '• ID/Passport: ' + (hasID ? '✓' : '✗') + '\n' +
                      '• Qualification Certificate: ' + (hasQual ? '✓' : '✗') + '\n' +
                      '• Signed Z83 Form: ' + (hasZ83 ? '✓' : '✗'));
                currentStep = 8;
                showStep(8);
                return false;
            }

            if (confirm('⚠️ Final Confirmation\n\n' +
                        'Are you sure you want to submit this application?\n\n' +
                        'Once submitted, you cannot make any changes.\n\n' +
                        'Click OK to submit or Cancel to review.')) {

                const btn = $('#submitBtn');
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Submitting...');

                const formData = gatherFormData();
                const request = {
                    applicationId: currentApplicationId,
                    application: formData
                };

                console.log('Submitting application:', request);

                $.ajax({
                    url: '/Application/Submit',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(request),
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            alert('✓ SUCCESS!\n\n' +
                                  'Your application has been submitted successfully!\n\n' +
                                  'Application ID: ' + response.applicationId);
                            window.location.href = '/Application/MyApplications';
                        } else {
                            const errorMsg = response.errors ? response.errors.join('\n') : response.message;
                            alert('❌ Submission Failed\n\n' + errorMsg);
                            btn.prop('disabled', false).html('<i class="fas fa-paper-plane me-2"></i>Submit Application');
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Submit error:', xhr.responseText);
                        console.error('Status:', xhr.status);

                        if (xhr.status === 401) {
                            alert('❌ Authentication Error\n\n' +
                                  'Your session has expired. Please log in again.');
                            window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                        } else if (xhr.status === 400) {
                            alert('❌ Validation Error\n\n' +
                                  'Please check that all required fields are filled correctly.');
                            btn.prop('disabled', false).html('<i class="fas fa-paper-plane me-2"></i>Submit Application');
                        } else {
                            alert('❌ An error occurred while submitting.\n\n' +
                                  'Error: ' + (xhr.responseText || error));
                            btn.prop('disabled', false).html('<i class="fas fa-paper-plane me-2"></i>Submit Application');
                        }
                    }
                });
            }
        });

        // ==================== GATHER FORM DATA ====================
        function gatherFormData() {
            const formData = {
                JobPostingId: parseInt($('[name="JobPostingId"]').val()),
                PositionInfo: {
                    JobTitle: $('[name="PositionInfo.JobTitle"]').val(),
                    Department: $('[name="PositionInfo.Department"]').val(),
                    ReferenceNumber: $('[name="PositionInfo.ReferenceNumber"]').val(),
                    NoticePeriod: $('[name="PositionInfo.NoticePeriod"]').val()
                },
                PersonalInfo: {
                    FirstName: $('[name="PersonalInfo.FirstName"]').val(),
                    LastName: $('[name="PersonalInfo.LastName"]').val(),
                    DateOfBirth: $('[name="PersonalInfo.DateOfBirth"]').val() || null,
                    IdPassportNumber: $('[name="PersonalInfo.IdPassportNumber"]').val(),
                    Race: parseInt($('[name="PersonalInfo.Race"]').val()) || 1,
                    Gender: parseInt($('[name="PersonalInfo.Gender"]').val()) || 1,
                    HasDisability: $('[name="PersonalInfo.HasDisability"]:checked').val() === 'true',
                    DisabilityDetails: $('[name="PersonalInfo.DisabilityDetails"]').val() || null,
                    IsSouthAfricanCitizen: $('[name="PersonalInfo.IsSouthAfricanCitizen"]:checked').val() === 'true',
                    Nationality: $('[name="PersonalInfo.Nationality"]').val() || null,
                    HasValidWorkPermit: $('[name="PersonalInfo.HasValidWorkPermit"]:checked').length > 0
                        ? $('[name="PersonalInfo.HasValidWorkPermit"]:checked').val() === 'true'
                        : null,
                    HasCriminalRecord: $('[name="PersonalInfo.HasCriminalRecord"]:checked').val() === 'true',
                    CriminalRecordDetails: $('[name="PersonalInfo.CriminalRecordDetails"]').val() || null,
                    HasPendingCriminalCase: $('[name="PersonalInfo.HasPendingCriminalCase"]:checked').val() === 'true',
                    PendingCriminalCaseDetails: $('[name="PersonalInfo.PendingCriminalCaseDetails"]').val() || null,
                    HasBeenDismissed: $('[name="PersonalInfo.HasBeenDismissed"]:checked').val() === 'true',
                    DismissalDetails: $('[name="PersonalInfo.DismissalDetails"]').val() || null,
                    HasPendingDisciplinary: $('[name="PersonalInfo.HasPendingDisciplinary"]:checked').val() === 'true',
                    PendingDisciplinaryDetails: $('[name="PersonalInfo.PendingDisciplinaryDetails"]').val() || null,
                    PrivateSectorExperienceYears: parseInt($('[name="PersonalInfo.PrivateSectorExperienceYears"]').val()) || 0,
                    PublicSectorExperienceYears: parseInt($('[name="PersonalInfo.PublicSectorExperienceYears"]').val()) || 0,
                    RequiresOfficialRegistration: $('[name="PersonalInfo.RequiresOfficialRegistration"]:checked').val() === 'true',
                    RegistrationDate: $('[name="PersonalInfo.RegistrationDate"]').val() || null,
                    RegistrationNumber: $('[name="PersonalInfo.RegistrationNumber"]').val() || null
                },
                ContactDetails: {
                    PhysicalAddress: $('[name="ContactDetails.PhysicalAddress"]').val(),
                    City: $('[name="ContactDetails.City"]').val(),
                    PostalCode: $('[name="ContactDetails.PostalCode"]').val(),
                    PhoneNumber: $('[name="ContactDetails.PhoneNumber"]').val(),
                    AlternativePhoneNumber: $('[name="ContactDetails.AlternativePhoneNumber"]').val() || null,
                    Email: $('[name="ContactDetails.Email"]').val(),
                    PreferredLanguage: $('[name="ContactDetails.PreferredLanguage"]').val(),
                    PreferredCommunicationMethod: $('[name="ContactDetails.PreferredCommunicationMethod"]').val()
                },
                LanguageProficiencies: [],
                Qualifications: [],
                WorkExperience: [],
                References: [],
                Documents: {
                    UploadedDocumentIds: uploadedDocuments.map(d => d.fileId)
                }
            };

            // Gather languages
            $('.language-item').each(function() {
                const language = $(this).find('[name$=".Language"]').val();
                if (language) {
                    formData.LanguageProficiencies.push({
                        Language: language,
                        SpeakLevel: $(this).find('[name$=".SpeakLevel"]').val(),
                        WriteReadLevel: $(this).find('[name$=".WriteReadLevel"]').val()
                    });
                }
            });

            // Gather qualifications
            $('.qualification-item').each(function() {
                const institution = $(this).find('[name$=".InstitutionName"]').val();
                if (institution) {
                    formData.Qualifications.push({
                        InstitutionName: institution,
                        QualificationName: $(this).find('[name$=".QualificationName"]').val(),
                        YearObtained: parseInt($(this).find('[name$=".YearObtained"]').val()),
                        FieldOfStudy: $(this).find('[name$=".FieldOfStudy"]').val() || null
                    });
                }
            });

            // Gather work experience
            $('.experience-item').each(function() {
                const employer = $(this).find('[name$=".EmployerName"]').val();
                if (employer) {
                    formData.WorkExperience.push({
                        EmployerName: employer,
                        Position: $(this).find('[name$=".Position"]').val(),
                        StartDate: $(this).find('[name$=".StartDate"]').val() || null,
                        EndDate: $(this).find('[name$=".EndDate"]').val() || null,
                        IsCurrentPosition: $(this).find('[name$=".IsCurrentPosition"]').is(':checked'),
                        ReasonForLeaving: $(this).find('[name$=".ReasonForLeaving"]').val() || null,
                        KeyResponsibilities: $(this).find('[name$=".KeyResponsibilities"]').val() || null
                    });
                }
            });

            // Gather references
            $('.reference-item').each(function() {
                const name = $(this).find('[name$=".Name"]').val();
                if (name) {
                    formData.References.push({
                        Name: name,
                        Relationship: $(this).find('[name$=".Relationship"]').val(),
                        PhoneNumber: $(this).find('[name$=".PhoneNumber"]').val(),
                        Email: $(this).find('[name$=".Email"]').val() || null,
                        Organization: $(this).find('[name$=".Organization"]').val() || null
                    });
                }
            });

            return formData;
        }

