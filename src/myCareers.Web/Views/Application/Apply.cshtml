                <div class="row mb-3">
                    <div class="col-md-6">
                        <h6><i class="fas fa-list-check me-2 text-primary"></i>Application Summary</h6>
                        <table class="table table-sm table-borderless">
                            <tr><td class="text-muted">Languages:</td><td><strong>${$('.language-item').length}</strong> proficiency(ies)</td></tr>
                            <tr><td class="text-muted">Qualifications:</td><td><strong>${$('.qualification-item').length}</strong> qualification(s)</td></tr>
                            <tr><td class="text-muted">Work Experience:</td><td><strong>${$('.experience-item').length}</strong> position(s)</td></tr>
                            <tr><td class="text-muted">References:</td><td><strong>${$('.reference-item').length}</strong> reference(s)</td></tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <h6><i class="fas fa-file-upload me-2 text-primary"></i>Uploaded Documents</h6>
                        ${docSummary ? '<ul class="list-unstyled">' + docSummary + '</ul>' : '<p class="text-danger"><i class="fas fa-exclamation-triangle me-2"></i>No documents uploaded</p>'}
                    </div>
                </div>
                <hr>
                <div class="alert alert-info mb-0">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>Please review all information carefully!</strong>
                    <ul class="mb-0 mt-2">
                        <li>Click "Previous" to make any changes</li>
                        <li>Check the declaration box below</li>
                        <li>Click "Submit Application" to finalize</li>
                    </ul>
                </div>
            `;
            $('#reviewSummary').html(html);
        }
    </script>
}
