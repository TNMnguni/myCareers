                            <!-- Resume -->
                            <div class="mb-4">
                                <label class="form-label required-field">Curriculum Vitae (CV/Resume)</label>
                                <input type="file" class="form-control doc-upload" data-doc-type="Resume" accept=".pdf,.jpg,.jpeg,.png" />
                                <div class="progress mt-2" style="display: none;">
                                    <div class="progress-bar" role="progressbar"></div>
                                </div>
                                <div class="upload-status mt-2"></div>
                                <div class="uploaded-files mt-2" data-doc-type="Resume"></div>
