                            <!-- ID Document -->
                            <div class="mb-4">
                                <label class="form-label required-field">ID Document / Passport</label>
                                <input type="file" class="form-control doc-upload" data-doc-type="ID" accept=".pdf,.jpg,.jpeg,.png" />
                                <div class="progress mt-2" style="display: none;">
                                    <div class="progress-bar" role="progressbar"></div>
