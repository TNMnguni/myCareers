@model myCareers.Application.DTOs.JobApplication.CreateJobApplicationDto
@{
    ViewData["Title"] = "Apply for Position";
}

<style>
    .step-indicator {
        display: flex;
        justify-content: space-between;
        margin-bottom: 30px;
        position: relative;
    }
    .step-indicator::before {
        content: '';
        position: absolute;
        top: 20px;
        left: 0;
        right: 0;
        height: 2px;
        background: #e0e0e0;
        z-index: -1;
    }
    .step {
        flex: 1;
        text-align: center;
        position: relative;
    }
    .step-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #e0e0e0;
        color: #666;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 10px;
        font-weight: bold;
        transition: all 0.3s;
    }
    .step.active .step-circle {
        background: #0d6efd;
        color: white;
    }
    .step.completed .step-circle {
        background: #198754;
        color: white;
    }
    .step-label {
        font-size: 12px;
        color: #666;
    }
    .step.active .step-label {
        color: #0d6efd;
        font-weight: bold;
    }
    .form-section {
        display: none;
    }
    .form-section.active {
        display: block;
    }
    .required-field::after {
        content: " *";
        color: red;
    }
</style>

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-file-signature me-2"></i>
                        Employment application for: @ViewBag.JobTitle post
                    </h3>
                    <p class="mb-0 mt-2"><small>@ViewBag.Department</small></p>
                </div>
                <div class="card-body p-4">
                    <!-- Step Indicator -->
                    <div class="step-indicator mb-4">
                        <div class="step active" data-step="1">
                            <div class="step-circle">1</div>
                            <div class="step-label">Position</div>
                        </div>
                        <div class="step" data-step="2">
                            <div class="step-circle">2</div>
                            <div class="step-label">Personal Info</div>
                        </div>
                        <div class="step" data-step="3">
                            <div class="step-circle">3</div>
                            <div class="step-label">Contact</div>
                        </div>
                        <div class="step" data-step="4">
                            <div class="step-circle">4</div>
                            <div class="step-label">Languages</div>
                        </div>
                        <div class="step" data-step="5">
                            <div class="step-circle">5</div>
                            <div class="step-label">Education</div>
                        </div>
                        <div class="step" data-step="6">
                            <div class="step-circle">6</div>
                            <div class="step-label">Experience</div>
                        </div>
                        <div class="step" data-step="7">
                            <div class="step-circle">7</div>
                            <div class="step-label">References</div>
                        </div>
                        <div class="step" data-step="8">
                            <div class="step-circle">8</div>
                            <div class="step-label">Documents</div>
                        </div>
                        <div class="step" data-step="9">
                            <div class="step-circle">9</div>
                            <div class="step-label">Review</div>
                        </div>
                    </div>

                    <form id="applicationForm" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="JobPostingId" />

                        <!-- Section 1: Position Information -->
                        <div class="form-section active" id="section-1">
                            <h4 class="border-bottom pb-2 mb-4">Section 1: Position Information</h4>
                            
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PositionInfo.JobTitle" class="form-label required-field">Job Title</label>
                                    <input asp-for="PositionInfo.JobTitle" class="form-control" readonly />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PositionInfo.Department" class="form-label required-field">Department</label>
                                    <input asp-for="PositionInfo.Department" class="form-control" readonly />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PositionInfo.ReferenceNumber" class="form-label required-field">Reference Number</label>
                                    <input asp-for="PositionInfo.ReferenceNumber" class="form-control" readonly />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PositionInfo.NoticePeriod" class="form-label required-field">Notice Period</label>
                                    <select asp-for="PositionInfo.NoticePeriod" class="form-select">
                                        <option value="">-- Select Notice Period --</option>
                                        <option value="Immediate">Immediate</option>
                                        <option value="1 week">1 Week</option>
                                        <option value="2 weeks">2 Weeks</option>
                                        <option value="1 month" selected>1 Month</option>
                                        <option value="2 months">2 Months</option>
                                        <option value="3 months">3 Months</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Section 2: Personal Information -->
                        <div class="form-section" id="section-2">
                            <h4 class="border-bottom pb-2 mb-4">Section 2: Personal Information</h4>
                            
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PersonalInfo.FirstName" class="form-label required-field">First Name</label>
                                    <input asp-for="PersonalInfo.FirstName" class="form-control" />
                                    <span asp-validation-for="PersonalInfo.FirstName" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PersonalInfo.LastName" class="form-label required-field">Last Name</label>
                                    <input asp-for="PersonalInfo.LastName" class="form-control" />
                                    <span asp-validation-for="PersonalInfo.LastName" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PersonalInfo.DateOfBirth" class="form-label required-field">Date of Birth</label>
                                    <input asp-for="PersonalInfo.DateOfBirth" type="date" class="form-control" max="@DateTime.Now.AddYears(-18).ToString("yyyy-MM-dd")" />
                                    <span asp-validation-for="PersonalInfo.DateOfBirth" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PersonalInfo.IdPassportNumber" class="form-label required-field">ID/Passport Number</label>
                                    <input asp-for="PersonalInfo.IdPassportNumber" class="form-control" />
                                    <span asp-validation-for="PersonalInfo.IdPassportNumber" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PersonalInfo.Race" class="form-label required-field">Race</label>
                                    <select asp-for="PersonalInfo.Race" class="form-select">
                                        <option value="">-- Select Race --</option>
                                        <option value="1">African</option>
                                        <option value="2">White</option>
                                        <option value="3">Coloured</option>
                                        <option value="4">Indian</option>
                                        <option value="5">Other</option>
                                    </select>
                                    <span asp-validation-for="PersonalInfo.Race" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PersonalInfo.Gender" class="form-label required-field">Gender</label>
                                    <select asp-for="PersonalInfo.Gender" class="form-select">
                                        <option value="">-- Select Gender --</option>
                                        <option value="1">Male</option>
                                        <option value="2">Female</option>
                                        <option value="3">Other</option>
                                        <option value="4">Prefer not to say</option>
                                    </select>
                                    <span asp-validation-for="PersonalInfo.Gender" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label required-field">Do you have a disability?</label>
                                <div class="form-check">
                                    <input asp-for="PersonalInfo.HasDisability" class="form-check-input" type="radio" value="true" id="disabilityYes">
                                    <label class="form-check-label" for="disabilityYes">Yes</label>
                                </div>
                                <div class="form-check">
                                    <input asp-for="PersonalInfo.HasDisability" class="form-check-input" type="radio" value="false" id="disabilityNo" checked>
                                    <label class="form-check-label" for="disabilityNo">No</label>
                                </div>
                            </div>

                            <div class="mb-3" id="disabilityDetailsDiv" style="display: none;">
                                <label asp-for="PersonalInfo.DisabilityDetails" class="form-label">Disability Details</label>
                                <textarea asp-for="PersonalInfo.DisabilityDetails" class="form-control" rows="2"></textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label required-field">Are you a South African citizen?</label>
                                <div class="form-check">
                                    <input asp-for="PersonalInfo.IsSouthAfricanCitizen" class="form-check-input" type="radio" value="true" id="citizenYes" checked>
                                    <label class="form-check-label" for="citizenYes">Yes</label>
                                </div>
                                <div class="form-check">
                                    <input asp-for="PersonalInfo.IsSouthAfricanCitizen" class="form-check-input" type="radio" value="false" id="citizenNo">
                                    <label class="form-check-label" for="citizenNo">No</label>
                                </div>
                            </div>

                            <div id="nonCitizenDiv" style="display: none;">
                                <div class="mb-3">
                                    <label asp-for="PersonalInfo.Nationality" class="form-label required-field">Nationality</label>
                                    <input asp-for="PersonalInfo.Nationality" class="form-control" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label required-field">Do you have a valid work permit?</label>
                                    <div class="form-check">
                                        <input asp-for="PersonalInfo.HasValidWorkPermit" class="form-check-input" type="radio" value="true" id="workPermitYes">
                                        <label class="form-check-label" for="workPermitYes">Yes</label>
                                    </div>
                                    <div class="form-check">
                                        <input asp-for="PersonalInfo.HasValidWorkPermit" class="form-check-input" type="radio" value="false" id="workPermitNo">
                                        <label class="form-check-label" for="workPermitNo">No</label>
                                    </div>
                                </div>
                            </div>

                            <!-- Criminal Record Questions -->
                            <hr class="my-4" />
                            <h5 class="mb-3">Legal & Employment History</h5>

                            <div class="mb-3">
                                <label class="form-label required-field">Have you been convicted or found guilty of a criminal offence?</label>
                                <div class="form-check">
                                    <input asp-for="PersonalInfo.HasCriminalRecord" class="form-check-input" type="radio" value="true" id="criminalYes">
                                    <label class="form-check-label" for="criminalYes">Yes</label>
                                </div>
                                <div class="form-check">
                                    <input asp-for="PersonalInfo.HasCriminalRecord" class="form-check-input" type="radio" value="false" id="criminalNo" checked>
                                    <label class="form-check-label" for="criminalNo">No</label>
                                </div>
                            </div>

                            <div class="mb-3" id="criminalDetailsDiv" style="display: none;">
                                <label asp-for="PersonalInfo.CriminalRecordDetails" class="form-label">Provide details</label>
                                <textarea asp-for="PersonalInfo.CriminalRecordDetails" class="form-control" rows="3"></textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label required-field">Do you have any pending criminal case against you?</label>
                                <div class="form-check">
                                    <input asp-for="PersonalInfo.HasPendingCriminalCase" class="form-check-input" type="radio" value="true" id="pendingCriminalYes">
                                    <label class="form-check-label" for="pendingCriminalYes">Yes</label>
                                </div>
                                <div class="form-check">
                                    <input asp-for="PersonalInfo.HasPendingCriminalCase" class="form-check-input" type="radio" value="false" id="pendingCriminalNo" checked>
                                    <label class="form-check-label" for="pendingCriminalNo">No</label>
                                </div>
                            </div>

                            <div class="mb-3" id="pendingCriminalDetailsDiv" style="display: none;">
                                <label asp-for="PersonalInfo.PendingCriminalCaseDetails" class="form-label">Provide details</label>
                                <textarea asp-for="PersonalInfo.PendingCriminalCaseDetails" class="form-control" rows="3"></textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label required-field">Have you ever been dismissed for misconduct from the Public Service?</label>
                                <div class="form-check">
                                    <input asp-for="PersonalInfo.HasBeenDismissed" class="form-check-input" type="radio" value="true" id="dismissedYes">
                                    <label class="form-check-label" for="dismissedYes">Yes</label>
                                </div>
                                <div class="form-check">
                                    <input asp-for="PersonalInfo.HasBeenDismissed" class="form-check-input" type="radio" value="false" id="dismissedNo" checked>
                                    <label class="form-check-label" for="dismissedNo">No</label>
                                </div>
                            </div>

                            <div class="mb-3" id="dismissalDetailsDiv" style="display: none;">
                                <label asp-for="PersonalInfo.DismissalDetails" class="form-label">Provide details</label>
                                <textarea asp-for="PersonalInfo.DismissalDetails" class="form-control" rows="3"></textarea>
                            </div>

                            <!-- Continue with remaining Yes/No questions... -->
                            <div class="mb-3">
                                <label class="form-label required-field">Do you have any pending disciplinary case against you?</label>
                                <div class="form-check">
                                    <input asp-for="PersonalInfo.HasPendingDisciplinary" class="form-check-input" type="radio" value="true" id="pendingDisciplinaryYes">
                                    <label class="form-check-label" for="pendingDisciplinaryYes">Yes</label>
                                </div>
                                <div class="form-check">
                                    <input asp-for="PersonalInfo.HasPendingDisciplinary" class="form-check-input" type="radio" value="false" id="pendingDisciplinaryNo" checked>
                                    <label class="form-check-label" for="pendingDisciplinaryNo">No</label>
                                </div>
                            </div>

                            <div class="mb-3" id="pendingDisciplinaryDetailsDiv" style="display: none;">
                                <label asp-for="PersonalInfo.PendingDisciplinaryDetails" class="form-label">Provide details</label>
                                <textarea asp-for="PersonalInfo.PendingDisciplinaryDetails" class="form-control" rows="3"></textarea>
                            </div>

                            <!-- Experience Years -->
                            <hr class="my-4" />
                            <h5 class="mb-3">Experience</h5>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PersonalInfo.PrivateSectorExperienceYears" class="form-label required-field">Private Sector Experience (Years)</label>
                                    <input asp-for="PersonalInfo.PrivateSectorExperienceYears" type="number" class="form-control" min="0" max="50" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PersonalInfo.PublicSectorExperienceYears" class="form-label required-field">Public Sector Experience (Years)</label>
                                    <input asp-for="PersonalInfo.PublicSectorExperienceYears" type="number" class="form-control" min="0" max="50" />
                                </div>
                            </div>

                            <!-- Professional Registration -->
                            <div class="mb-3">
                                <label class="form-label">Does your profession require official registration?</label>
                                <div class="form-check">
                                    <input asp-for="PersonalInfo.RequiresOfficialRegistration" class="form-check-input" type="radio" value="true" id="registrationYes">
                                    <label class="form-check-label" for="registrationYes">Yes</label>
                                </div>
                                <div class="form-check">
                                    <input asp-for="PersonalInfo.RequiresOfficialRegistration" class="form-check-input" type="radio" value="false" id="registrationNo" checked>
                                    <label class="form-check-label" for="registrationNo">No</label>
                                </div>
                            </div>

                            <div id="registrationDetailsDiv" style="display: none;">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="PersonalInfo.RegistrationDate" class="form-label">Registration Date</label>
                                        <input asp-for="PersonalInfo.RegistrationDate" type="date" class="form-control" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="PersonalInfo.RegistrationNumber" class="form-label">Registration Number</label>
                                        <input asp-for="PersonalInfo.RegistrationNumber" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Section 3: Contact Details -->
                        <div class="form-section" id="section-3">
                            <h4 class="border-bottom pb-2 mb-4">Section 3: Contact Details</h4>
                            
                            <div class="mb-3">
                                <label asp-for="ContactDetails.PhysicalAddress" class="form-label required-field">Physical Address</label>
                                <textarea asp-for="ContactDetails.PhysicalAddress" class="form-control" rows="2"></textarea>
                                <span asp-validation-for="ContactDetails.PhysicalAddress" class="text-danger"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="ContactDetails.City" class="form-label required-field">City</label>
                                    <input asp-for="ContactDetails.City" class="form-control" />
                                    <span asp-validation-for="ContactDetails.City" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="ContactDetails.PostalCode" class="form-label required-field">Postal Code</label>
                                    <input asp-for="ContactDetails.PostalCode" class="form-control" />
                                    <span asp-validation-for="ContactDetails.PostalCode" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="ContactDetails.PhoneNumber" class="form-label required-field">Phone Number</label>
                                    <input asp-for="ContactDetails.PhoneNumber" type="tel" class="form-control" placeholder="+27 XX XXX XXXX" />
                                    <span asp-validation-for="ContactDetails.PhoneNumber" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="ContactDetails.AlternativePhoneNumber" class="form-label">Alternative Phone Number</label>
                                 <input asp-for="ContactDetails.AlternativePhoneNumber" type="tel" class="form-control" placeholder="+27 XX XXX XXXX" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ContactDetails.Email" class="form-label required-field">Email Address</label>
                                <input asp-for="ContactDetails.Email" type="email" class="form-control" />
                                <span asp-validation-for="ContactDetails.Email" class="text-danger"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="ContactDetails.PreferredLanguage" class="form-label required-field">Preferred Language for Correspondence</label>
                                    <select asp-for="ContactDetails.PreferredLanguage" class="form-select">
                                        <option value="">-- Select Language --</option>
                                        <option value="English">English</option>
                                        <option value="Afrikaans">Afrikaans</option>
                                        <option value="Zulu">Zulu</option>
                                        <option value="Xhosa">Xhosa</option>
                                        <option value="Sotho">Sotho</option>
                                        <option value="Tswana">Tswana</option>
                                        <option value="Pedi">Pedi</option>
                                        <option value="Venda">Venda</option>
                                        <option value="Tsonga">Tsonga</option>
                                        <option value="Swati">Swati</option>
                                        <option value="Ndebele">Ndebele</option>
                                    </select>
                                    <span asp-validation-for="ContactDetails.PreferredLanguage" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="ContactDetails.PreferredCommunicationMethod" class="form-label required-field">Preferred Method of Communication</label>
                                    <select asp-for="ContactDetails.PreferredCommunicationMethod" class="form-select">
                                        <option value="">-- Select Method --</option>
                                        <option value="Email">Email</option>
                                        <option value="Phone">Phone</option>
                                        <option value="Post">Post</option>
                                        <option value="SMS">SMS</option>
                                    </select>
                                    <span asp-validation-for="ContactDetails.PreferredCommunicationMethod" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Section 4: Language Proficiency -->
                        <div class="form-section" id="section-4">
                            <h4 class="border-bottom pb-2 mb-4">Section 4: South African Official Language Proficiency</h4>
                            <p class="text-muted mb-3">Rate your proficiency as 'Good', 'Fair', or 'Poor'</p>
                            
                            <div id="languagesContainer">
                                <div class="language-item mb-3 border p-3 rounded">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <label class="form-label">Language</label>
                                            <select class="form-select language-select" name="LanguageProficiencies[0].Language">
                                                <option value="">-- Select Language --</option>
                                                <option value="English">English</option>
                                                <option value="Afrikaans">Afrikaans</option>
                                                <option value="Zulu">Zulu</option>
                                                <option value="Xhosa">Xhosa</option>
                                                <option value="Sotho">Sotho</option>
                                                <option value="Tswana">Tswana</option>
                                                <option value="Pedi">Pedi</option>
                                                <option value="Venda">Venda</option>
                                                <option value="Tsonga">Tsonga</option>
                                                <option value="Swati">Swati</option>
                                                <option value="Ndebele">Ndebele</option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Speaking</label>
                                            <select class="form-select" name="LanguageProficiencies[0].SpeakLevel">
                                                <option value="">-- Select --</option>
                                                <option value="Good">Good</option>
                                                <option value="Fair">Fair</option>
                                                <option value="Poor">Poor</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">Reading/Writing</label>
                                            <select class="form-select" name="LanguageProficiencies[0].WriteReadLevel">
                                                <option value="">-- Select --</option>
                                                <option value="Good">Good</option>
                                                <option value="Fair">Fair</option>
                                                <option value="Poor">Poor</option>
                                            </select>
                                        </div>
                                        <div class="col-md-1 d-flex align-items-end">
                                            <button type="button" class="btn btn-sm btn-danger remove-language" style="display: none;">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <button type="button" class="btn btn-outline-primary btn-sm" id="addLanguage">
                                <i class="fas fa-plus me-1"></i>Add Another Language
                            </button>
                        </div>

                        <!-- Section 5: Qualifications -->
                        <div class="form-section" id="section-5">
                            <h4 class="border-bottom pb-2 mb-4">Section 5: Formal Qualifications</h4>
                            <p class="text-muted mb-3">List your qualifications from highest (most recent) to lowest</p>
                            
                            <div id="qualificationsContainer">
                                <div class="qualification-item mb-3 border p-3 rounded">
                                    <div class="row">
                                        <div class="col-md-5">
                                            <label class="form-label required-field">Institution Name</label>
                                            <input type="text" class="form-control" name="Qualifications[0].InstitutionName" placeholder="e.g., University of Pretoria" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label required-field">Qualification</label>
                                            <input type="text" class="form-control" name="Qualifications[0].QualificationName" placeholder="e.g., Bachelor of Science" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label required-field">Year</label>
                                            <input type="number" class="form-control" name="Qualifications[0].YearObtained" min="1950" max="@DateTime.Now.Year" />
                                        </div>
                                        <div class="col-md-1 d-flex align-items-end">
                                            <button type="button" class="btn btn-sm btn-danger remove-qualification" style="display: none;">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="row mt-2">
                                        <div class="col-md-12">
                                            <label class="form-label">Field of Study (Optional)</label>
                                            <input type="text" class="form-control" name="Qualifications[0].FieldOfStudy" placeholder="e.g., Computer Science" />
                                        </div>
                                    </div>
                                </div>
