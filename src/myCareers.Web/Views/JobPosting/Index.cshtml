@model List<myCareers.Application.DTOs.JobPosting.JobPostingDto>
@{
    ViewData["Title"] = "My Job Postings";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-briefcase me-2"></i>My Job Postings</h2>
                <a asp-action="Create" class="btn btn-success">
                    <i class="fas fa-plus me-2"></i>Create New Job
                </a>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h5 class="card-title">Total Jobs</h5>
                    <h2 class="mb-0">@ViewBag.TotalJobs</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h5 class="card-title">Active Jobs</h5>
                    <h2 class="mb-0">@ViewBag.ActiveJobs</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <h5 class="card-title">Draft Jobs</h5>
                    <h2 class="mb-0">@ViewBag.DraftJobs</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white">
                <div class="card-body">
                    <h5 class="card-title">Closed Jobs</h5>
                    <h2 class="mb-0">@ViewBag.ClosedJobs</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Job Listings Table -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">All Job Postings</h5>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Department</th>
                                <th>Status</th>
                                <th>Applications</th>
                                <th>Closing Date</th>
                                <th>Created</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var job in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@job.Title</strong><br />
                                        <small class="text-muted">@job.Location</small>
                                    </td>
                                    <td>@job.Department</td>
                                    <td>
                                        @if (job.IsClosed)
                                        {
                                            <span class="badge bg-danger">Closed</span>
                                        }
                                        else if (job.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@job.StatusDisplay</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@job.ApplicationCount</span>
                                    </td>
                                    <td>
                                        @job.ClosingDate.ToString("dd MMM yyyy")
                                        @if (job.DaysUntilClosing < 7 && job.DaysUntilClosing > 0)
                                        {
                                            <br />
                                
                                            <small class="text-warning">@job.DaysUntilClosing days left</small>
                                        }
                                    </td>
                                    <td>@job.CreatedDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@job.Id" class="btn btn-sm btn-info" title="View">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@job.Id" class="btn btn-sm btn-primary" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>

                                            @if (job.IsActive)
                                            {
                                                <form asp-action="Deactivate" asp-route-id="@job.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-warning" title="Deactivate" onclick="return confirm('Deactivate this job posting?')">
                                                        <i class="fas fa-pause"></i>
                                                    </button>
                                                </form>
                                            }
                                            else if (job.Status == myCareers.Core.Enums.JobStatus.Draft)
                                            {
                                                <form asp-action="Publish" asp-route-id="@job.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-success" title="Publish">
                                                        <i class="fas fa-paper-plane"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="Activate" asp-route-id="@job.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-success" title="Activate">
                                                        <i class="fas fa-play"></i>
                                                    </button>
                                                </form>
                                            }

                                            <form asp-action="Delete" asp-route-id="@job.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger" title="Delete" onclick="return confirm('Are you sure you want to delete this job posting?')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-briefcase fa-3x text-muted mb-3"></i>
                    <p class="text-muted">You haven't created any job postings yet.</p>
                    <a asp-action="Create" class="btn btn-success">
                        <i class="fas fa-plus me-2"></i>Create Your First Job
                    </a>
                </div>
            }
        </div>
    </div>
</div>