@model myCareers.Application.DTOs.JobApplication.JobApplicationDto

@{
    ViewData["Title"] = "Application Details";
}

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2><i class="fas fa-file-alt me-2"></i>Application Details</h2>
                    <p class="text-muted mb-0">Ref: @Model.ReferenceNumber</p>
                </div>
                <div>
                    <a asp-controller="RecruiterApplication" asp-action="JobApplications" asp-route-jobId="@Model.JobPostingId" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back to Applications
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Left Column: Application Info -->
        <div class="col-md-8">
            <!-- Status Banner -->
            <div class="alert @GetStatusAlertClass(Model.Status) mb-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-1">
                            <i class="fas @GetStatusIcon(Model.Status) me-2"></i>Status: @Model.StatusDisplay
                        </h5>
                        @if (Model.ReviewedDate.HasValue)
                        {
                            <small>Reviewed on: @Model.ReviewedDate.Value.ToString("dd MMM yyyy HH:mm")</small>
                        }
                        @if (Model.InterviewDate.HasValue)
                        {
                            <small class="ms-3">Interview: @Model.InterviewDate.Value.ToString("dd MMM yyyy HH:mm")</small>
                        }
                    </div>
                    <div>
                        <span class="badge bg-light text-dark">Applied @Model.DaysSinceApplied days ago</span>
                    </div>
                </div>
            </div>

            <!-- Applicant Information -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-user me-2"></i>Applicant Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Name:</strong> @Model.ApplicantName</p>
                            <p><strong>Email:</strong> @Model.ApplicantEmail</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Phone:</strong> @(Model.PhoneNumber ?? "Not provided")</p>
                            <p><strong>Applied Date:</strong> @Model.AppliedDate.ToString("dd MMM yyyy")</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Position Information -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-briefcase me-2"></i>Position Applied For</h5>
                </div>
                <div class="card-body">
                    <p><strong>Job Title:</strong> @Model.JobTitle</p>
                    <p><strong>Department:</strong> @Model.Department</p>
                    <p class="mb-0"><strong>Reference Number:</strong> @Model.ReferenceNumber</p>
                </div>
            </div>

            <!-- Supporting Documents -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-paperclip me-2"></i>Supporting Documents</h5>
                </div>
                <div class="card-body">
                    <div class="list-group">
                        @if (!string.IsNullOrEmpty(Model.ResumeUrl))
                        {
                            <a href="@Model.ResumeUrl" target="_blank" class="list-group-item list-group-item-action">
                                <i class="fas fa-file-pdf text-danger me-2"></i>Resume/CV
                                <i class="fas fa-external-link-alt float-end"></i>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(Model.IdDocumentUrl))
                        {
                            <a href="@Model.IdDocumentUrl" target="_blank" class="list-group-item list-group-item-action">
                                <i class="fas fa-file-pdf text-danger me-2"></i>ID/Passport Document
                                <i class="fas fa-external-link-alt float-end"></i>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(Model.QualificationCertificateUrl))
                        {
                            <a href="@Model.QualificationCertificateUrl" target="_blank" class="list-group-item list-group-item-action">
                                <i class="fas fa-file-pdf text-danger me-2"></i>Qualification Certificate
                                <i class="fas fa-external-link-alt float-end"></i>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(Model.TranscriptUrl))
                        {
                            <a href="@Model.TranscriptUrl" target="_blank" class="list-group-item list-group-item-action">
                                <i class="fas fa-file-pdf text-danger me-2"></i>Academic Transcript
                                <i class="fas fa-external-link-alt float-end"></i>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(Model.Z83FormUrl))
                        {
                            <a href="@Model.Z83FormUrl" target="_blank" class="list-group-item list-group-item-action">
                                <i class="fas fa-file-pdf text-danger me-2"></i>Z83 Form (Signed)
                                <i class="fas fa-external-link-alt float-end"></i>
                            </a>
                        }
                    </div>
                    @if (string.IsNullOrEmpty(Model.ResumeUrl) && string.IsNullOrEmpty(Model.IdDocumentUrl))
                    {
                        <p class="text-muted mb-0">No documents uploaded</p>
                    }
                </div>
            </div>

            <!-- Review Notes -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-sticky-note me-2"></i>Review Notes</h5>
                </div>
                <div class="card-body">
                    <form id="reviewNotesForm">
                        <input type="hidden" id="applicationId" value="@Model.Id" />
                        <textarea class="form-control" id="reviewNotes" rows="5" placeholder="Add your review notes here...">@Model.ReviewNotes</textarea>
                        <button type="button" class="btn btn-primary mt-3" id="saveNotes">
                            <i class="fas fa-save me-2"></i>Save Notes
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Right Column: Actions -->
        <div class="col-md-4">
            <!-- Quick Actions -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-tasks me-2"></i>Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        @if (Model.Status == myCareers.Core.Enums.ApplicationStatus.UnderReview ||
                                                Model.Status == myCareers.Core.Enums.ApplicationStatus.Shortlisted)
                        {
                            <button class="btn btn-success" id="btnAccept">
                                <i class="fas fa-check-circle me-2"></i>Accept Application
                            </button>
                            <button class="btn btn-primary" id="btnShortlist">
                                <i class="fas fa-star me-2"></i>Shortlist
                            </button>
                        }

                        @if (Model.Status == myCareers.Core.Enums.ApplicationStatus.Accepted ||
                                                Model.Status == myCareers.Core.Enums.ApplicationStatus.Shortlisted ||
                                                Model.Status == myCareers.Core.Enums.ApplicationStatus.InterviewScheduled)
                        {
                            <button class="btn btn-info" id="btnScheduleInterview">
                                <i class="fas fa-calendar-alt me-2"></i>Schedule Interview
                            </button>
                        }

                        @if (Model.Status == myCareers.Core.Enums.ApplicationStatus.Submitted ||
                                                Model.Status == myCareers.Core.Enums.ApplicationStatus.UnderReview ||
                                                Model.Status == myCareers.Core.Enums.ApplicationStatus.Shortlisted)
                        {
                            <button class="btn btn-danger" id="btnReject">
                                <i class="fas fa-times-circle me-2"></i>Reject Application
                            </button>
                        }

                        @if (Model.Status != myCareers.Core.Enums.ApplicationStatus.Accepted &&
                                                Model.Status != myCareers.Core.Enums.ApplicationStatus.InterviewScheduled)
                        {
                            <hr />
                            <button class="btn btn-outline-danger" id="btnDelete">
                                <i class="fas fa-trash me-2"></i>Delete Application
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Application Timeline -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-history me-2"></i>Timeline</h5>
                </div>
                <div class="card-body">
                    <ul class="timeline">
                        <li>
                            <i class="fas fa-paper-plane bg-info"></i>
                            <div class="timeline-item">
                                <span class="time"><i class="fas fa-clock"></i> @Model.AppliedDate.ToString("dd MMM yyyy")</span>
                                <h3 class="timeline-header">Application Submitted</h3>
                            </div>
                        </li>
                        @if (Model.ReviewedDate.HasValue)
                        {
                            <li>
                                <i class="fas fa-eye bg-warning"></i>
                                <div class="timeline-item">
                                    <span class="time"><i class="fas fa-clock"></i> @Model.ReviewedDate.Value.ToString("dd MMM yyyy")</span>
                                    <h3 class="timeline-header">Under Review</h3>
                                </div>
                            </li>
                        }
                        @if (Model.Status == myCareers.Core.Enums.ApplicationStatus.Shortlisted)
                        {
                            <li>
                                <i class="fas fa-star bg-primary"></i>
                                <div class="timeline-item">
                                    <h3 class="timeline-header">Shortlisted</h3>
                                </div>
                            </li>
                        }
                        @if (Model.InterviewDate.HasValue)
                        {
                            <li>
                                <i class="fas fa-calendar-check bg-success"></i>
                                <div class="timeline-item">
                                    <span class="time"><i class="fas fa-clock"></i> @Model.InterviewDate.Value.ToString("dd MMM yyyy HH:mm")</span>
                                    <h3 class="timeline-header">Interview Scheduled</h3>
                                </div>
                            </li>
                        }
                        @if (Model.Status == myCareers.Core.Enums.ApplicationStatus.Accepted)
                        {
                            <li>
                                <i class="fas fa-check-circle bg-success"></i>
                                <div class="timeline-item">
                                    <h3 class="timeline-header">Accepted</h3>
                                </div>
                            </li>
                        }
                        @if (Model.Status == myCareers.Core.Enums.ApplicationStatus.Rejected)
                        {
                            <li>
                                <i class="fas fa-times-circle bg-danger"></i>
                                <div class="timeline-item">
                                    <h3 class="timeline-header">Rejected</h3>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Schedule Interview Modal -->
<div class="modal fade" id="scheduleInterviewModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Schedule Interview</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="interviewForm">
                    <div class="mb-3">
                        <label class="form-label">Interview Date & Time <span class="text-danger">*</span></label>
                        <input type="datetime-local" class="form-control" id="interviewDateTime" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Interview Notes</label>
                        <textarea class="form-control" id="interviewNotes" rows="3" placeholder="Add notes about the interview (location, format, etc.)"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmScheduleInterview">Schedule</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            const applicationId = @Model.Id;

            // Save review notes
            $('#saveNotes').on('click', function() {
                const notes = $('#reviewNotes').val();

                $.ajax({
                    url: '@Url.Action("AddReviewNotes", "RecruiterApplication")',
                    type: 'POST',
                    data: {
                        id: applicationId,
                        reviewNotes: notes,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            toastr.success('Review notes saved successfully');
                        } else {
                            toastr.error(response.message || 'Failed to save notes');
                        }
                    },
                    error: function() {
                        toastr.error('An error occurred while saving notes');
                    }
                });
            });

            // Accept application
            $('#btnAccept').on('click', function() {
                if (confirm('Are you sure you want to accept this application?')) {
                    $.ajax({
                        url: '@Url.Action("AcceptApplication", "RecruiterApplication")',
                        type: 'POST',
                        data: {
                            id: applicationId,
                            interviewDate: null,
                            interviewNotes: null,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.success) {
                                toastr.success(response.message);
                                setTimeout(() => location.reload(), 1500);
                            } else {
                                toastr.error(response.message);
                            }
                        },
                        error: function() {
                            toastr.error('An error occurred');
                        }
                    });
                }
            });

            // Shortlist application
            $('#btnShortlist').on('click', function() {
                $.ajax({
                    url: '@Url.Action("Shortlist", "RecruiterApplication")',
                    type: 'POST',
                    data: {
                        id: applicationId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            toastr.success(response.message);
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            toastr.error(response.message);
                        }
                    },
                    error: function() {
                        toastr.error('An error occurred');
                    }
                });
            });

            // Schedule interview
            $('#btnScheduleInterview').on('click', function() {
                $('#scheduleInterviewModal').modal('show');
            });

            $('#confirmScheduleInterview').on('click', function() {
                const interviewDate = $('#interviewDateTime').val();
                const notes = $('#interviewNotes').val();

                if (!interviewDate) {
                    toastr.error('Please select an interview date and time');
                    return;
                }

                $.ajax({
                    url: '@Url.Action("ScheduleInterview", "RecruiterApplication")',
                    type: 'POST',
                    data: {
                        id: applicationId,
                        interviewDate: interviewDate,
                        interviewNotes: notes,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            toastr.success(response.message);
                            $('#scheduleInterviewModal').modal('hide');
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            toastr.error(response.message);
                        }
                    },
                    error: function() {
                        toastr.error('An error occurred');
                    }
                });
            });

            // Reject application
            $('#btnReject').on('click', function() {
                const reason = prompt('Enter reason for rejection (optional):');
                if (reason !== null) {
                    $.ajax({
                        url: '@Url.Action("RejectApplication", "RecruiterApplication")',
                        type: 'POST',
                        data: {
                            id: applicationId,
                            rejectionReason: reason,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.success) {
                                toastr.success(response.message);
                                setTimeout(() => location.reload(), 1500);
                            } else {
                                toastr.error(response.message);
                            }
                        },
                        error: function() {
                            toastr.error('An error occurred');
                        }
                    });
                }
            });

            // Delete application
            $('#btnDelete').on('click', function() {
                if (confirm('Are you sure you want to permanently delete this application? This action cannot be undone.')) {
                    $.ajax({
                        url: '@Url.Action("DeleteApplication", "RecruiterApplication")/' + applicationId,
                        type: 'DELETE',
                        data: {
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.success) {
                                toastr.success(response.message);
                                setTimeout(() => {
                                    window.location.href = '@Url.Action("JobApplications", "RecruiterApplication", new { jobId = Model.JobPostingId })';
                                }, 1500);
                            } else {
                                toastr.error(response.message);
                            }
                        },
                        error: function() {
                            toastr.error('An error occurred');
                        }
                    });
                }
            });
        });
    </script>

    <style>
        .timeline {
            list-style: none;
            padding: 20px 0;
            position: relative;
        }

            .timeline:before {
                top: 0;
                bottom: 0;
                position: absolute;
                content: " ";
                width: 3px;
                background-color: #eeeeee;
                left: 50px;
                margin-left: -1.5px;
            }

            .timeline > li {
                margin-bottom: 20px;
                position: relative;
            }

                .timeline > li:before,
                .timeline > li:after {
                    content: " ";
                    display: table;
                }

                .timeline > li:after {
                    clear: both;
                }

                .timeline > li > .timeline-item {
                    margin-left: 60px;
                }

                .timeline > li > .fa,
                .timeline > li > .fas,
                .timeline > li > .far,
                .timeline > li > .fab {
                    width: 40px;
                    height: 40px;
                    font-size: 18px;
                    line-height: 40px;
                    position: absolute;
                    color: #fff;
                    border-radius: 50%;
                    text-align: center;
                    left: 30px;
                }

        .timeline-header {
            margin-top: 0;
            font-size: 16px;
            font-weight: 600;
        }

        .time {
            font-size: 12px;
            color: #999;
        }
    </style>
}

@functions {
    string GetStatusAlertClass(myCareers.Core.Enums.ApplicationStatus status)
    {
        return status switch
        {
            myCareers.Core.Enums.ApplicationStatus.Submitted => "alert-info",
            myCareers.Core.Enums.ApplicationStatus.UnderReview => "alert-warning",
            myCareers.Core.Enums.ApplicationStatus.Shortlisted => "alert-primary",
            myCareers.Core.Enums.ApplicationStatus.InterviewScheduled => "alert-success",
            myCareers.Core.Enums.ApplicationStatus.Accepted => "alert-success",
            myCareers.Core.Enums.ApplicationStatus.Rejected => "alert-danger",
            _ => "alert-secondary"
        };
    }

    string GetStatusIcon(myCareers.Core.Enums.ApplicationStatus status)
    {
        return status switch
        {
            myCareers.Core.Enums.ApplicationStatus.Submitted => "fa-paper-plane",
            myCareers.Core.Enums.ApplicationStatus.UnderReview => "fa-eye",
            myCareers.Core.Enums.ApplicationStatus.Shortlisted => "fa-star",
            myCareers.Core.Enums.ApplicationStatus.InterviewScheduled => "fa-calendar-check",
            myCareers.Core.Enums.ApplicationStatus.Accepted => "fa-check-circle",
            myCareers.Core.Enums.ApplicationStatus.Rejected => "fa-times-circle",
            _ => "fa-info-circle"
        };
    }
}